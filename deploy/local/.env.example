# Copy is not required for normal setup.
# Run ./deploy/local/bin/create-local-env.sh to create .env.local instead.

ORCA_LOCAL_DB_HOST=localhost
ORCA_LOCAL_DB_PORT=3306
ORCA_LOCAL_DB_NAME=orca
ORCA_LOCAL_DB_USERNAME=orca
ORCA_LOCAL_DB_PASSWORD=<local-db-password>
ORCA_LOCAL_DB_ROOT_PASSWORD=<local-root-password>
ORCA_LOCAL_DB_MODE=compose
ORCA_LOCAL_DB_CONTAINER=<existing-mariadb-container-name>

ORCA_LOCAL_FRONTEND_COMPONENT=orca-frontend
ORCA_LOCAL_BACKEND_COMPONENT=orca-backend
ORCA_LOCAL_DB_COMPONENT=orca-db
ORCA_LOCAL_BACKEND_PORT=8080
ORCA_LOCAL_FRONTEND_PORT=5173
ORCA_LOCAL_BACKEND_DB_HOST=orca-db
ORCA_LOCAL_BACKEND_DB_PORT=3306
ORCA_FRONTEND_API_PROXY_TARGET=http://orca-backend:8080

ORCA_LOCAL_LOGIN_IDENTIFIER=local-login
ORCA_LOCAL_LOGIN_PASSWORD=<local-login-password>
